PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./marketwise.db
# Optional external data directory (database, uploads and reports).
STORAGE_DIR=
# Built frontend directory; leave empty for local Vite development.
STATIC_DIR=
PUBLIC_DEMO=false
# This application has no login: production on 0.0.0.0 requires PUBLIC_DEMO=true.
# Keep the default loopback host for local use with this template.
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=60
MAX_RESEARCH_TRAINING=1
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
MAX_UPLOAD_MB=20
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=200
MAX_DATASET_MEMORY_MB=128
MAX_CONCURRENT_ANALYSES=1
MAX_PENDING_JOBS=8
JOB_TTL_SECONDS=3600
ENABLE_WIKIPEDIA=true
# Tra cứu công khai đa nguồn tại /api/research (tự động bật tìm kiếm web rộng)
RESEARCH_WIKIPEDIA=true
RESEARCH_WIKIDATA=true
RESEARCH_DUCKDUCKGO=true
RESEARCH_GOOGLE_NEWS=true
RESEARCH_OPENALEX=true
RESEARCH_FETCH_PAGES=true
# Khóa bổ sung tùy chọn (chỉ đặt ở backend; không dùng VITE_* cho khóa này).
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=
# Có thể dùng Tavily độc lập; dự phòng khi Brave lỗi/hết hạn mức/không có kết quả.
TAVILY_API_KEY=
